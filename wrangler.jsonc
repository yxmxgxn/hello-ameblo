{
  "name": "ameblo-search",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Worker を通すのは API だけ。画面(静的ファイル)は Worker を通さず配信する
    "run_worker_first": ["/api/*"]
  },
  // 毎時7分に GitHub Actions のクロールを起動する(src/worker.js の scheduled)
  "triggers": {
    "crons": ["7 * * * *"]
  },
  // 1分あたりの同一IPからのAPI呼び出し上限(Workers のレート制限バインディング)
  "unsafe": {
    "bindings": [
      { "name": "RL", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ameblo-search",
      // ダッシュボード → ストレージとデータベース → D1 → ameblo-search(karin-archive と同じアカウント)
      "database_id": "f34033ab-4b0f-44d3-87cb-0259ef7c2de7"
    }
  ]
}
